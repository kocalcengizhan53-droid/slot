{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The portal's fonts, icons and share image. A request that matches a file is served from
  // the edge without running the Worker.
  "assets": { "directory": "./public" },
  // Cloudflare will not let a Worker fetch its own workers.dev address on the same account (it
  // answers 404), so webhooks pointed at the portal's own test receiver go through a binding to
  // this Worker instead. SELF_HOST says which deliveries those are.
  "services": [{ "binding": "SELF", "service": "slot" }],
  "vars": { "SELF_HOST": "slot.kocalcengizhan.workers.dev" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slot-db",
      "database_id": "193ce439-748e-4413-b0eb-5cbadfea7d2a",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    // Per key: sixty requests a minute, so one tenant's burst never slows another's.
    { "name": "API_RATE", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    // Per address: ten new sandboxes a minute.
    { "name": "SANDBOX_RATE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Expire holds, retry webhook deliveries, delete old sandboxes, idempotency keys and latency.
  "triggers": { "crons": ["*/5 * * * *"] }
}
